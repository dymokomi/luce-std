## The `files` module against its archive: a file written, read back, described and
## removed, in a temporary place.
import c
import files
import io
import strings

test "a file round trip":
    let directory = io.path.temp()
    let path = try strings.join([directory, "/luce-base-files-test.txt"], "")
    defer strings.release(path)
    try files.write((c.str)path, "one line\n".bytes)
    assert(files.exists((c.str)path))
    let back = try files.read((c.str)path)
    defer free(back)
    assert((str)back == "one line\n")
    let info = try files.metadata((c.str)path)
    assert(info.size == 9)
    try files.remove_file((c.str)path)
    assert(not files.exists((c.str)path))

test "a temporary file loses its name once open and still reads back":
    let directory = io.path.temp()
    let path = try strings.join([directory, "/luce-base-files-temporary.bin"], "")
    defer strings.release(path)
    var opened = try files.File.open((c.str)path, files.OpenMode.create_temporary, permissions = 384)
    # POSIX: no name left to find; the open file lives on until it closes.
    assert(not files.exists((c.str)path))
    assert((try opened.write("scratch".bytes)) == 7)
    var back: u8[7]
    discard(try opened.seek(0, files.SeekOrigin.start))
    assert((try opened.read(back)) == 7)
    assert((str)back[..<7] == "scratch")
    try opened.close()

test "canonical paths resolve links, and a missing entry is missing":
    let base = try files.canonical((c.str)io.path.temp())
    let root = try files.create_temporary_directory((c.str)base)
    defer files.remove_tree((c.str)root) catch ignored:
        discard(ignored)
    let real = try strings.join([root, "/real"], "")
    try files.create_directory((c.str)real)
    let file = try strings.join([real, "/file.txt"], "")
    try files.write((c.str)file, "x".bytes)
    let link = try strings.join([root, "/link"], "")
    try files.create_symlink((c.str)real, (c.str)link, true)
    # through the link, and through a `..` that leaves it, the file's own path comes back
    let through = try strings.join([link, "/file.txt"], "")
    assert((try files.canonical((c.str)through)) == file)
    let around = try strings.join([link, "/../real/file.txt"], "")
    assert((try files.canonical((c.str)around)) == file)
    assert((try files.canonical((c.str)link)) == real)
    let absent = try strings.join([root, "/absent.txt"], "")
    let answer = files.canonical((c.str)absent) catch failure:
        assert(failure.code == files.missing)
        recover "missing"
    assert(answer == "missing")
