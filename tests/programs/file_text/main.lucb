import c
import files
import interop
import paths

pub func main(arguments: str[]) -> i32!:
    let joined = try paths.join(arguments[1], "héllo.txt")
    defer joined.release()
    let path = joined.value
    try files.write_text(path, "")
    let empty = try files.read_text(path)
    defer empty.release()
    assert(empty.value == "")
    try files.write_text(path, "éλ😀\r\n")
    let loaded = try files.read_text(path)
    defer loaded.release()
    assert(loaded.value == "éλ😀\r\n")
    assert((try files.metadata((c.str)path)).kind == files.FileKind.regular)
    let absolute = try files.canonical((c.str)path)
    defer absolute.release()
    assert(paths.base(absolute.value) == "héllo.txt")
    let names = try files.list((c.str)arguments[1])
    defer names.release()
    var found = false
    for name in names.value:
        found = found or name == "héllo.txt"
    assert(found)
    var rejected = false
    discard(files.read_text(path, limit = 1) catch failure:
        rejected = true
        recover interop.Owned[str](""))
    assert(rejected)
    try files.write((c.str)path, [255])
    rejected = false
    discard(files.read_text(path) catch failure:
        rejected = true
        recover interop.Owned[str](""))
    assert(rejected)
    rejected = false
    files.write_text("bad\0path", "safe") catch failure:
        rejected = true
    assert(rejected)
    let fresh = try paths.join(arguments[1], "created-λ.txt")
    defer fresh.release()
    let copied = try paths.join(arguments[1], "copied-λ.txt")
    defer copied.release()
    let moved = try paths.join(arguments[1], "moved-λ.txt")
    defer moved.release()
    try files.create_text(fresh.value, "complete 😀")
    rejected = false
    files.create_text(fresh.value, "overwrite") catch failure:
        assert(failure.code == files.already_exists)
        rejected = true
    assert(rejected)
    try files.copy((c.str)fresh.value, (c.str)copied.value)
    rejected = false
    files.copy((c.str)fresh.value, (c.str)copied.value) catch failure:
        assert(failure.code == files.already_exists)
        rejected = true
    assert(rejected)
    rejected = false
    files.rename((c.str)copied.value, (c.str)fresh.value, replace = false) catch failure:
        assert(failure.code == files.already_exists)
        rejected = true
    assert(rejected)
    try files.rename((c.str)copied.value, (c.str)moved.value)
    let contents = try files.read_text(moved.value)
    defer contents.release()
    assert(contents.value == "complete 😀")
    try files.remove_file((c.str)fresh.value)
    try files.remove_file((c.str)moved.value)
    let directory = try paths.join(arguments[1], "directory-λ/inner")
    defer directory.release()
    try files.ensure_directory(directory.value)
    try files.ensure_directory(directory.value)
    rejected = false
    files.create_directory((c.str)directory.value) catch failure:
        assert(failure.code == files.already_exists)
        rejected = true
    assert(rejected)
    let outer = try paths.join(arguments[1], "directory-λ")
    defer outer.release()
    try files.remove_tree((c.str)outer.value)
    let home = try files.home_directory()
    defer home.release()
    assert(home.value.length > 0)
    return 0
