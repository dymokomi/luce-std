# The generated Unicode tables are what tools/unicode_tables.py makes from the vendored,
# checksum-verified UCD data: a table edited by hand, or data changed without regenerating,
# fails here.
from luce_std import process

let failed = ErrorCode.package(1)

pub func main(arguments: list[str]) -> int!:
    let done = process.run("python3", ["tools/unicode_tables.py", "--check"])
    print(done.output.trim_end())
    if done.exit_code != 0:
        error(failed, f"unicode_tables.py --check: exit status {done.exit_code}\n{done.error_output}")
    return 0
