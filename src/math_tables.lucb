## pi/2 less the three parts above, rounded.
pub let pio2_4: u64 = 0x397b839a252049c1

## pi/2 rounded to a double.
pub let pio2_high: u64 = 0x3ff921fb54442d18

## pi/2 less its double.
pub let pio2_low: u64 = 0x3c91a62633145c07

## pi rounded to a double.
pub let pi_high: u64 = 0x400921fb54442d18

## pi less its double.
pub let pi_low: u64 = 0x3ca1a62633145c07

## 2/pi rounded to a double.
pub let two_over_pi_double: u64 = 0x3fe45f306dc9c883

## pi/128 as a multiple of 2^-32 (27 bits): times n below 2^26, exact.
pub let step_1: u64 = 0x3f9921fb54000000

