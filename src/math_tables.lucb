## ln(2) as a multiple of 2^-42: times any exponent k, exact.
pub let ln2_high: u64 = 0x3fe62e42fefa3800

## ln(2) less ln2_high.
pub let ln2_low: u64 = 0x3d2ef35793c76730

## ln(2) rounded to a double.
pub let ln2_double_high: u64 = 0x3fe62e42fefa39ef

## ln(2) less its double.
pub let ln2_double_low: u64 = 0x3c7abc9e3b39803f

## ln(2)/128 as a multiple of 2^-42: 35 bits, times k below 2^18, exact.
pub let ln2_128_high: u64 = 0x3f762e42fefc0000

## ln(2)/128 less ln2_128_high.
pub let ln2_128_low: u64 = 0xbd3c610ca86c3899

## 128/ln(2) rounded.
pub let inverse_ln2_128: u64 = 0x40671547652b82fe

## 1/ln(2), high part.
pub let log2_e_high: u64 = 0x3ff71547652b82fe

## 1/ln(2), low part.
pub let log2_e_low: u64 = 0x3c7777d0ffda0d24

## 1/ln(10), high part.
pub let log10_e_high: u64 = 0x3fdbcb7b1526e50e

## 1/ln(10), low part.
pub let log10_e_low: u64 = 0x3c695355baaafad3

## pi/2 as a multiple of 2^-32 (33 bits): times n below 2^20, exact.
pub let pio2_1: u64 = 0x3ff921fb54400000

## The next 33 bits of pi/2.
pub let pio2_2: u64 = 0x3dd0b4611a600000

## The next 33 bits of pi/2.
